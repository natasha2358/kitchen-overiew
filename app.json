{
  "expo": {
    "name": "Smart Kitchen",
    "slug": "smart-kitchen",
    "scheme": "smartkitchen",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.smartkitchen.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
