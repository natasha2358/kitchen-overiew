{
  "name": "smart-kitchen",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "build": "expo export --platform android --platform web",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:db": "node scripts/test-database.mjs",
    "db:types": "node scripts/generate-types.mjs",
    "test:services": "node scripts/test-services.mjs",
    "test:edge": "deno test --allow-read --config supabase/functions/deno.json supabase/functions/_shared/pdf_test.ts supabase/functions/_shared/telemetry_test.ts supabase/functions/_shared/receipt-text_test.ts supabase/functions/_shared/receipt-model_test.ts",
    "check:edge": "deno check --config supabase/functions/deno.json supabase/functions/verify-receipt/index.ts supabase/functions/parse-receipt/index.ts supabase/functions/delete-receipt-source/index.ts supabase/functions/suggest-meals/index.ts supabase/functions/erase-account/index.ts supabase/functions/_shared/receipt-text.ts",
    "test:auth": "node scripts/test-auth.mjs",
    "test:handlers": "node scripts/test-handlers.mjs",
    "cloud:edge:prepare": "node scripts/prepare-cloud-edge.mjs",
    "cloud:edge:start": "node scripts/start-cloud-edge.mjs",
    "test:edge:gateway": "node scripts/test-edge-gateway.mjs",
    "test:erasure": "node scripts/test-erasure.mjs",
    "test:receipt-processing": "node scripts/test-receipt-processing.mjs"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.104.5",
    "decimal.js": "10.6.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "~19.3.0",
    "deno": "2.9.6",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "30.5.2",
    "jest-expo": "~58.0.12",
    "jose": "4.13.1",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "unpdf": "1.9.1"
  }
}
